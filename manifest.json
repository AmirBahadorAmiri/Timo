{
  "manifest_version": 3,
  "name": "Timo — تسک و تقویم فارسی",
  "short_name": "Timo",
  "version": "2.0.0",
  "description": "داشبورد مدیریت تسک به همراه تقویم فارسی با تعطیلات و مناسبت‌ها",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
